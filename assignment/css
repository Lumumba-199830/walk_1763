css: * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f0f4ff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 40px;
}

.form-box {
    background-color: #dce8ff;
    padding: 40px;
    border-radius: 12px;
    width: 420px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

h1 {
    color: #1a3a8f;
    font-size: 26px;
    margin-bottom: 25px;
    text-align: center;
}

.field {
    margin-bottom: 18px;
}

label {
    display: block;
    color: #1a3a8f;
    font-weight: bold;
    margin-bottom: 6px;
}

input, textarea {
    width: 100%;
    padding: 10px;
    border: 2px solid #aac0f0;
    border-radius: 6px;
    font-size: 15px;
    background-color: #ffffff;
}

textarea {
    height: 100px;
    resize: vertical;
}

button {
    background-color: #1a3a8f;
    color: white;
    padding: 12px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
    width: 100%;
    margin-top: 10px;
}

button:hover {
    background-color: #2a52bf;
}

.links {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
    color: #1a3a8f;
}

.links a {
    color: #1a3a8f;
    font-weight: bold;
    text-decoration: none;
}

.links a:hover {
    text-decoration: underline;
}